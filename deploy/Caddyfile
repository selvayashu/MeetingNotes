# Automatic HTTPS (Let's Encrypt) in front of the MeetNotes API.
# Point an A record for DOMAIN at this server before starting the "https" profile.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 300MB
	}
	reverse_proxy api:8000 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
