# ---- MeetNotes backend configuration. Copy to .env and edit. ----

# Speech-to-text (faster-whisper). CPU: tiny | base | small (recommended) | medium. GPU: large-v3 / large-v3-turbo.
WHISPER_MODEL=small
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto -> int8 on CPU, float16 on GPU
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=0          # 0 = all cores
WHISPER_VAD=true
# Languages "Auto-detect" may choose from (stops Hindi being mislabelled as Urdu). Empty = any.
AUTO_LANGUAGES=en,hi,ta

# Route a language to another open-source engine (needs INSTALL_EXTRAS="indic"), separated by ";".
#   hf:<HF Whisper checkpoint>       e.g. IndicWhisper fine-tunes such as vasista22/whisper-tamil-medium
#   indicconformer:<model>           e.g. ai4bharat/indic-conformer-600m-multilingual
# STT_ROUTES=ta=hf:vasista22/whisper-tamil-medium;hi=indicconformer:ai4bharat/indic-conformer-600m-multilingual
STT_ROUTES=
INDICCONFORMER_DECODER=ctc     # ctc | rnnt

# LLM via Ollama. On a CPU-only 8 GB server use qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=900
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.2
LLM_CHUNK_CHARS=6000           # longer transcripts are summarised in parts, then merged

# Speaker labels with pyannote.audio (needs INSTALL_EXTRAS="diarization").
ENABLE_DIARIZATION=false
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=                      # free Hugging Face read token; only for gated models such as pyannote

# Docker build extras, space-separated: indic diarization gpu
INSTALL_EXTRAS=

# Security. ACCESS_TOKEN is a password you invent; enter the same value in the app's Settings.
ACCESS_TOKEN=
CORS_ORIGINS=*                 # in production: https://your-app.netlify.app
MAX_UPLOAD_MB=300

# Networking
API_BIND=127.0.0.1             # 0.0.0.0 to use the API from other devices on your LAN
API_PORT=8000
DOMAIN=                        # e.g. api.example.com, for the "https" profile (Caddy)
