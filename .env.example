# ───────────────────────────── Browser (public) ─────────────────────────────
# Local: .env.local        Cloudflare Pages: build environment variables
# These end up in the JavaScript bundle. The anon key is safe to expose; RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Client-side cap on recording length (minutes). Keep equal to MAX_RECORDING_MINUTES below.
VITE_MAX_RECORDING_MINUTES=90

# ───────────────────── Server only (Pages Functions) ─────────────────────
# Local: .dev.vars (copy .dev.vars.example)
# Production: Pages secrets (`npx wrangler pages secret put NAME`). NEVER prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Defaults live in wrangler.toml [vars]; override locally in .dev.vars.
# MAX_MEETINGS_PER_DAY=10        # processed meetings per user per UTC day
# MAX_RECORDING_MINUTES=90       # server-side length cap
# LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ─────────────────────────── Cloudflare / AI ───────────────────────────
# Workers AI needs no key in code: it is the [ai] binding in wrangler.toml (env.AI).
# Only needed if you deploy from CI instead of the Pages Git integration:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
