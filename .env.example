# Browser (public) — set in .env.local and in Cloudflare Pages build env vars
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only — put in .dev.vars locally and Pages secrets in production. NEVER prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Workers AI is accessed through the [ai] binding in wrangler.toml (no key needed in code).
# Only needed for deploying from CI:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
